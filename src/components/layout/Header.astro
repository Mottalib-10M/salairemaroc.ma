---
const currentPath = Astro.url.pathname;

const calculateurs = [
  { href: '/calculateurs/', label: 'Tous les calculateurs' },
  { href: '/calculateur-salaire-net/', label: 'Brut vers Net' },
  { href: '/calculateur-net-vers-brut/', label: 'Net vers Brut' },
  { href: '/calculateur-cout-employeur/', label: 'Coût Employeur' },
  { href: '/simulateur-ir/', label: 'Simulateur IR' },
];

const guides = [
  { href: '/guides/', label: 'Tous les guides' },
  { href: '/guides/smig-maroc/', label: 'SMIG au Maroc' },
  { href: '/guides/comprendre-bulletin-paie/', label: 'Comprendre son bulletin' },
  { href: '/guides/bareme-ir-maroc/', label: 'Barème IR Maroc' },
];
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <span class="text-charcoal">Salaire</span>
      <span class="text-brand">Maroc</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Menu principal">
      <!-- Calculateurs dropdown -->
      <div class="dropdown-wrapper relative">
        <button
          type="button"
          class:list={[
            'flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            calculateurs.some(i => i.href === currentPath)
              ? 'bg-brand/10 text-brand'
              : 'text-dark-gray hover:bg-light-gray hover:text-charcoal',
          ]}
        >
          Calculateurs
          <svg class="h-3.5 w-3.5 opacity-60 transition-transform duration-200 dropdown-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="dropdown-panel invisible absolute left-0 top-full z-50 min-w-[220px] rounded-lg border border-gray-200 bg-white py-2 opacity-0 shadow-lg transition-all duration-150">
          {calculateurs.map(({ href, label }) => (
            <a
              href={href}
              class:list={[
                'block px-4 py-2 text-sm transition-colors',
                currentPath === href
                  ? 'bg-brand/10 font-medium text-brand'
                  : 'text-gray-700 hover:bg-gray-50 hover:text-charcoal',
              ]}
              aria-current={currentPath === href ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
        </div>
      </div>

      <!-- CNSS link -->
      <a
        href="https://www.cnss.ma"
        class="rounded-lg px-3 py-2 text-sm font-medium text-dark-gray transition-colors hover:bg-light-gray hover:text-charcoal"
        target="_blank"
        rel="noopener"
      >
        CNSS
      </a>

      <!-- Guides dropdown -->
      <div class="dropdown-wrapper relative">
        <button
          type="button"
          class:list={[
            'flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            currentPath.startsWith('/guides')
              ? 'bg-brand/10 text-brand'
              : 'text-dark-gray hover:bg-light-gray hover:text-charcoal',
          ]}
        >
          Guides
          <svg class="h-3.5 w-3.5 opacity-60 transition-transform duration-200 dropdown-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="dropdown-panel invisible absolute left-0 top-full z-50 min-w-[220px] rounded-lg border border-gray-200 bg-white py-2 opacity-0 shadow-lg transition-all duration-150">
          {guides.map(({ href, label }) => (
            <a
              href={href}
              class:list={[
                'block px-4 py-2 text-sm transition-colors',
                currentPath === href
                  ? 'bg-brand/10 font-medium text-brand'
                  : 'text-gray-700 hover:bg-gray-50 hover:text-charcoal',
              ]}
              aria-current={currentPath === href ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Mobile menu toggle -->
    <button
      id="mobile-menu-toggle"
      class="rounded-lg p-2 text-dark-gray hover:bg-light-gray md:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-gray-200 bg-white px-4 pb-4 md:hidden"
    aria-label="Menu mobile"
  >
    <!-- Calculateurs section -->
    <div class="mobile-section">
      <button
        type="button"
        class="mobile-section-toggle flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-sm font-semibold text-charcoal transition-colors hover:bg-light-gray"
      >
        Calculateurs
        <svg class="h-4 w-4 opacity-50 transition-transform duration-200 mobile-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div class="mobile-section-items hidden pl-2">
        {calculateurs.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'block rounded-lg px-3 py-2 text-sm transition-colors',
              currentPath === href
                ? 'bg-brand/10 font-medium text-brand'
                : 'text-dark-gray hover:bg-light-gray',
            ]}
          >
            {label}
          </a>
        ))}
      </div>
    </div>

    <!-- Guides section -->
    <div class="mobile-section">
      <button
        type="button"
        class="mobile-section-toggle flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-sm font-semibold text-charcoal transition-colors hover:bg-light-gray"
      >
        Guides
        <svg class="h-4 w-4 opacity-50 transition-transform duration-200 mobile-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div class="mobile-section-items hidden pl-2">
        {guides.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'block rounded-lg px-3 py-2 text-sm transition-colors',
              currentPath === href
                ? 'bg-brand/10 font-medium text-brand'
                : 'text-dark-gray hover:bg-light-gray',
            ]}
          >
            {label}
          </a>
        ))}
      </div>
    </div>

    <a
      href="https://www.cnss.ma"
      class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-charcoal transition-colors hover:bg-light-gray"
      target="_blank"
      rel="noopener"
    >
      CNSS
    </a>
  </nav>
</header>

<style>
  .dropdown-wrapper:hover .dropdown-panel,
  .dropdown-wrapper:focus-within .dropdown-panel {
    visibility: visible;
    opacity: 1;
  }
  .dropdown-wrapper:hover .dropdown-chevron,
  .dropdown-wrapper:focus-within .dropdown-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
    });
  }

  document.querySelectorAll('.mobile-section-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const section = btn.closest('.mobile-section');
      if (!section) return;
      const items = section.querySelector('.mobile-section-items');
      const chevron = btn.querySelector('.mobile-chevron');
      if (items) items.classList.toggle('hidden');
      if (chevron) chevron.classList.toggle('rotate-180');
    });
  });
</script>
