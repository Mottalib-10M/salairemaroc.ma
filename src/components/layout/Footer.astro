---
import { SITE_NAME, CURRENT_FISCAL_YEAR, TAGLINE } from '../../config';
import {
  footerCalcLinks,
  footerGuideLinks,
  footerSalaireLinks,
  footerExternalLinks,
  footerLegalLinks,
} from '../../data/nav';

const calculateurs = footerCalcLinks;

const guidesLinks = footerGuideLinks;

const salaires = footerSalaireLinks;

const liensUtiles = footerExternalLinks;

const legal = footerLegalLinks;
---

<footer class="border-t border-gray-200 bg-light-gray">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <nav aria-label="Navigation de pied de page">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-6">
      <div class="lg:col-span-2">
        <a href="/" class="mb-4 inline-block text-lg font-bold">
          <span class="text-charcoal">Salaire </span>
          <span class="text-brand">Maroc</span>
        </a>
        <p class="text-sm text-medium-gray">
          {TAGLINE} Données mises à jour pour {CURRENT_FISCAL_YEAR}.
        </p>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-charcoal">
          Calculateurs
        </h3>
        <ul class="space-y-2">
          {calculateurs.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-medium-gray transition-colors hover:text-brand">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-charcoal">
          Guides
        </h3>
        <ul class="space-y-2">
          {guidesLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-medium-gray transition-colors hover:text-brand">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-charcoal">
          Salaires
        </h3>
        <ul class="space-y-2">
          {salaires.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-medium-gray transition-colors hover:text-brand">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-charcoal">
          Liens utiles
        </h3>
        <ul class="space-y-2">
          {liensUtiles.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-medium-gray transition-colors hover:text-brand" target="_blank" rel="noopener">
                {label}
              </a>
            </li>
          ))}
        </ul>
        <h3 class="mb-3 mt-6 text-sm font-semibold uppercase tracking-wider text-charcoal">
          Légal
        </h3>
        <ul class="space-y-2">
          {legal.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-medium-gray transition-colors hover:text-brand">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    </nav>

    <div class="mt-10 border-t border-gray-300 pt-6">
      <p class="text-center text-xs text-medium-gray">
        &copy; {new Date().getFullYear()} {SITE_NAME}. Les informations fournies le sont à titre indicatif et ne constituent pas un conseil fiscal.
        {' '}Sources : <a href="https://www.tax.gov.ma" class="underline hover:text-brand" target="_blank" rel="noopener">DGI</a>,
        <a href="https://www.cnss.ma" class="underline hover:text-brand" target="_blank" rel="noopener">CNSS</a>,
        <a href="https://www.emploi.gov.ma" class="underline hover:text-brand" target="_blank" rel="noopener">Code du Travail</a>.
      </p>
    </div>
  </div>
</footer>
