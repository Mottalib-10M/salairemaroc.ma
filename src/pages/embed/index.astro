---
import { SITE_NAME, SITE_URL, BRAND_COLOR, CURRENT_FISCAL_YEAR } from '../../config';
import SalaireNet from '../../components/calculateurs/SalaireNet';
import '../../styles/global.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Calculateur Salaire Net Maroc {CURRENT_FISCAL_YEAR} - {SITE_NAME}</title>
    <meta name="description" content="Widget embarquable - Calculateur salaire brut en net au Maroc" />
    <style>
      body {
        margin: 0;
        padding: 16px;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: #ffffff;
      }
    </style>
  </head>
  <body>
    <div class="mx-auto max-w-2xl">
      <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
        <div class="mb-4 flex items-center justify-between">
          <h1 class="text-lg font-bold text-charcoal">
            Calculateur Salaire Net {CURRENT_FISCAL_YEAR}
          </h1>
          <a
            href={SITE_URL}
            target="_blank"
            rel="noopener"
            class="text-xs text-gray-400 hover:text-brand transition-colors"
          >
            par {SITE_NAME}
          </a>
        </div>
        <SalaireNet client:idle />
      </div>
      <div class="mt-3 text-center">
        <a
          href={`${SITE_URL}/calculateur-salaire-net/`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 text-xs text-gray-400 hover:text-brand transition-colors"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Voir le calculateur complet sur {SITE_NAME}
        </a>
      </div>
    </div>
  </body>
</html>
