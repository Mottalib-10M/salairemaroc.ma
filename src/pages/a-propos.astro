---
import Layout from '../components/layout/Layout.astro';
import { SITE_NAME, CURRENT_FISCAL_YEAR, CONTACT_EMAIL, AUTHOR_NAME, AUTHOR_CREDENTIALS } from '../config';
import { buildPersonSchema, buildBreadcrumbSchema } from '../lib/seo';

const title = `À propos – ${AUTHOR_NAME}, ${AUTHOR_CREDENTIALS} et Fiscalité`;
const description = `${SITE_NAME} est créé par ${AUTHOR_NAME}. Calculateurs de salaire brut/net gratuits, fiables et mis à jour pour le Maroc en ${CURRENT_FISCAL_YEAR}.`;

const schemas = [
  buildPersonSchema({
    name: AUTHOR_NAME,
    jobTitle: 'Éditeur de calculateurs et de guides pratiques',
    description: `${AUTHOR_NAME} édite ${SITE_NAME}. La société publie des calculateurs de paie et de fiscalité marocaine, avec une méthode de calcul détaillée et les textes officiels cités sur chaque page.`,
    knowsAbout: [
      'Fiscalité marocaine',
      'Impôt sur le Revenu (IR)',
      'Cotisations CNSS',
      'Salaire brut et net',
      'Finances personnelles',
    ],
  }),
  buildBreadcrumbSchema([
    { name: 'Accueil', url: '/' },
    { name: 'À propos', url: '/a-propos/' },
  ]),
];
---

<Layout title={title} description={description} schema={schemas}>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-6 text-sm text-medium-gray" aria-label="Fil d'Ariane">
      <ol class="flex items-center gap-1">
        <li><a href="/" class="hover:text-brand">Accueil</a></li>
        <li>/</li>
        <li class="text-charcoal">À propos</li>
      </ol>
    </nav>

    <h1 class="mb-8 text-3xl font-bold text-charcoal md:text-4xl">À propos de {SITE_NAME}</h1>

    <div class="grid gap-8 md:grid-cols-3">
      <!-- Author card -->
      <div class="flex flex-col items-center rounded-xl border border-gray-200 p-6 text-center">
        <div class="mb-4 h-32 w-32 overflow-hidden rounded-full bg-gray-200">
          </div>
        <h2 class="text-xl font-bold text-charcoal">{AUTHOR_NAME}</h2>
        <p class="text-sm text-brand font-medium">Fondateur & Éditeur</p>
        <p class="mt-1 text-sm text-medium-gray">{AUTHOR_CREDENTIALS}</p>
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="mt-4 rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-dark"
        >
          Me contacter
        </a>
      </div>

      <!-- Content -->
      <div class="md:col-span-2 prose max-w-none text-dark-gray leading-relaxed">
        <h2>Notre mission</h2>
        <p>
          {SITE_NAME} est né d'un constat simple : trop de salariés marocains ne comprennent pas le passage de leur salaire brut à leur salaire net. Les calculs impliquent les cotisations CNSS, les frais professionnels, l'impôt sur le revenu progressif et les déductions familiales. Notre mission est de rendre ces calculs transparents, instantanés et accessibles à tous.
        </p>
        <p>
          Chaque calculateur est conçu pour être précis, rapide et pédagogique. Nous ne nous contentons pas de donner un chiffre : nous détaillons chaque étape du calcul pour que vous compreniez exactement d'où vient votre salaire net.
        </p>

        <h2>Qui édite ce site&nbsp;?</h2>
        <p>
          {SITE_NAME} est édité par <strong>{AUTHOR_NAME}</strong>, société spécialisée dans les calculateurs et les guides pratiques de finances personnelles. Nous avons créé ce site pour que les salariés marocains puissent comprendre leur fiche de paie sans avoir à déchiffrer les textes fiscaux.
        </p>
        <p>
          Notre travail repose sur trois exigences&nbsp;: reprendre les barèmes directement dans les textes officiels, publier la méthode de calcul pour que chacun puisse la vérifier, et corriger le site dès qu'un barème change. La compréhension de sa situation fiscale est un droit&nbsp;; les outils pour y parvenir doivent être gratuits et transparents.
        </p>

        <h2>Fiabilité des données</h2>
        <p>
          Les calculs présents sur {SITE_NAME} sont basés sur les données officielles publiées par :
        </p>
        <ul>
          <li><a href="https://www.tax.gov.ma" class="text-brand hover:underline" target="_blank" rel="noopener">La Direction Générale des Impôts (DGI)</a> pour le barème IR et les déductions</li>
          <li><a href="https://www.cnss.ma" class="text-brand hover:underline" target="_blank" rel="noopener">La Caisse Nationale de Sécurité Sociale (CNSS)</a> pour les taux de cotisation et les plafonds</li>
          <li>Le Code du Travail marocain pour le SMIG et les dispositions légales</li>
        </ul>
        <p>
          Les données sont mises à jour pour l'exercice fiscal {CURRENT_FISCAL_YEAR}. En cas de modification législative, nous mettons à jour nos calculateurs dans les meilleurs délais.
        </p>

        <h2>Contact</h2>
        <p>
          Pour toute question, suggestion ou signalement d'erreur, vous pouvez me contacter directement à l'adresse : <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand hover:underline">{CONTACT_EMAIL}</a>.
        </p>
        <p>
          <strong>Avertissement :</strong> Les informations et résultats fournis par {SITE_NAME} sont donnés à titre indicatif. Ils ne constituent en aucun cas un conseil fiscal ou juridique. Pour des questions spécifiques à votre situation, consultez un expert-comptable ou un conseiller fiscal agréé.
        </p>
      </div>
    </div>

    <!-- Internal links -->
    <section class="mt-10 mb-8">
      <h2 class="mb-4 text-xl font-bold text-charcoal">Nos outils et ressources</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/calculateurs/" class="group rounded-lg border border-gray-200 p-3 transition-all hover:border-brand hover:shadow-sm">
          <h3 class="font-semibold text-charcoal group-hover:text-brand text-sm">Calculateurs de salaire</h3>
          <p class="text-xs text-gray-500">Tous nos outils gratuits</p>
        </a>
        <a href="/guides/" class="group rounded-lg border border-gray-200 p-3 transition-all hover:border-brand hover:shadow-sm">
          <h3 class="font-semibold text-charcoal group-hover:text-brand text-sm">Guides salaire et fiscalité</h3>
          <p class="text-xs text-gray-500">IR, SMIG, bulletin de paie</p>
        </a>
        <a href="/" class="group rounded-lg border border-gray-200 p-3 transition-all hover:border-brand hover:shadow-sm">
          <h3 class="font-semibold text-charcoal group-hover:text-brand text-sm">Calculateur brut/net</h3>
          <p class="text-xs text-gray-500">Notre outil principal</p>
        </a>
      </div>
    </section>
  </div>
</Layout>
