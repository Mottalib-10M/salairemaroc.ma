---
import Layout from '../../components/layout/Layout.astro';
import SalaireNet from '../../components/calculateurs/SalaireNet';
import { CURRENT_FISCAL_YEAR } from '../../config';
import { buildWebApplicationSchema, buildBreadcrumbSchema, buildFAQSchema, type FAQItem } from '../../lib/seo';
import { formatDH, formatDHArrondi, formatAmountTitle } from '../../lib/format';
import { calculerSalaireNet, SMIG_MENSUEL, type DecompositionSalaire } from '../../lib/salaire-engine';
import { SALARY_PAGES, type SalaryPageConfig } from '../../data/salary-pages';
import {
  getBandContext,
  getCareerDescription,
  getTaxTips,
  buildFaqs,
  getRaiseSimulation,
  getBudgetBreakdown,
  getUniqueComparisons,
  getRegionalContext,
  getSMIGComparison,
  getAnnualBreakdown,
} from '../../lib/salary-content';

const allPages = SALARY_PAGES;

export function getStaticPaths() {
  return SALARY_PAGES.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props { page: SalaryPageConfig; }

const { page } = Astro.props;

const result = calculerSalaireNet(page.amount, 0);
const amountFormatted = formatAmountTitle(page.amount);

// Family scenarios
const familyScenarios = [
  { label: 'C\u00e9libataire, sans charge', dep: 0 },
  { label: 'Mari\u00e9(e), 0 enfant', dep: 1 },
  { label: 'Mari\u00e9(e), 1 enfant', dep: 2 },
  { label: 'Mari\u00e9(e), 2 enfants', dep: 3 },
  { label: 'Mari\u00e9(e), 3 enfants', dep: 4 },
].map(s => ({
  ...s,
  result: calculerSalaireNet(page.amount, s.dep),
}));

// Adjacent pages
const currentIndex = allPages.findIndex(p => p.slug === page.slug);
const adjacent = allPages.filter((_, i) => Math.abs(i - currentIndex) > 0 && Math.abs(i - currentIndex) <= 3);

// SEO
const title = `${amountFormatted} DH Brut en Net au Maroc ${CURRENT_FISCAL_YEAR} : Salaire D\u00e9taill\u00e9`;
const description = `Salaire de ${amountFormatted} DH brut en net au Maroc ${CURRENT_FISCAL_YEAR} : d\u00e9tail complet CNSS, IR, frais professionnels, d\u00e9ductions et tableau par situation familiale. Calcul gratuit.`;

// Generate UNIQUE content
const bandContext = getBandContext(page.amount, result);
const careerDescription = getCareerDescription(page.amount, page.rangeCategory);
const taxTips = getTaxTips(page.amount, result);
const faqs = buildFaqs(page.amount, result);
const raiseSimulation = getRaiseSimulation(page.amount, result);
const budgetBreakdown = getBudgetBreakdown(result.netMensuel, page.amount);
const uniqueComparisons = getUniqueComparisons(page.amount, result);
const regionalContext = getRegionalContext(page.amount, result.netMensuel);
const smigComparison = getSMIGComparison(page.amount, result);
const annualBreakdown = getAnnualBreakdown(page.amount, result);

const totalDeductions = result.cnssAnnuel + result.irAnnuel;
const pctDeduction = (totalDeductions / result.brutAnnuel * 100).toFixed(1);

const schemas = [
  buildWebApplicationSchema(`Calcul ${amountFormatted} DH Brut Net`, `/salaire/${page.slug}/`),
  buildBreadcrumbSchema([
    { name: 'Accueil', url: '/' },
    { name: 'Salaires', url: '/salaire/' },
    { name: `${amountFormatted} DH brut`, url: `/salaire/${page.slug}/` },
  ]),
  buildFAQSchema(faqs),
];
---

<Layout title={title} description={description} schema={schemas}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-medium-gray" aria-label="Fil d'Ariane">
      <ol class="flex items-center gap-1">
        <li><a href="/" class="hover:text-brand">Accueil</a></li>
        <li>/</li>
        <li class="text-charcoal">{amountFormatted} DH brut en net</li>
      </ol>
    </nav>

    <h1 class="mb-6 text-3xl font-bold text-charcoal md:text-4xl">
      {amountFormatted} DH Brut en Net au Maroc ({CURRENT_FISCAL_YEAR})
    </h1>

    <!-- Hero result -->
    <div class="mb-8 rounded-xl bg-gradient-to-br from-gray-50 to-gray-100 p-6 text-center">
      <p class="text-sm text-gray-500">Avec un salaire brut de {amountFormatted} DH/mois, vous recevrez environ</p>
      <p class="mt-2 text-5xl font-bold text-brand">{formatDH(result.netMensuel)}</p>
      <p class="mt-1 text-lg text-gray-600">net par mois (c&eacute;libataire, sans charge)</p>
      <a href={`/#brut=${page.amount}`} class="mt-4 inline-block rounded-lg bg-brand px-6 py-3 font-medium text-white transition-colors hover:bg-brand-dark">
        Calculer mon cas exact
      </a>
    </div>

    <!-- Calculator embedded -->
    <section class="mb-8">
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <SalaireNet client:idle initialBrut={page.amount} />
      </div>
    </section>

    <!-- Detailed breakdown -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">
        D&eacute;composition du salaire de {amountFormatted} DH brut
      </h2>
      <div class="overflow-hidden rounded-lg border border-gray-200">
        <table class="w-full text-sm">
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-medium text-charcoal">Salaire brut mensuel</td><td class="px-4 py-2 text-right tabular-nums font-medium">{formatDH(page.amount)}</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 text-gray-600">CNSS - Prestations sociales (0,52%)</td><td class="px-4 py-2 text-right tabular-nums text-red-600">-{formatDH(result.cnssDetail.prestationsSociales)}</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 text-gray-600">CNSS - AMO (2,26%)</td><td class="px-4 py-2 text-right tabular-nums text-red-600">-{formatDH(result.cnssDetail.amo)}</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 text-gray-600">CNSS - Retraite (3,96%)</td><td class="px-4 py-2 text-right tabular-nums text-red-600">-{formatDH(result.cnssDetail.retraite)}</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-medium text-charcoal">Total CNSS salari&eacute;</td><td class="px-4 py-2 text-right tabular-nums font-medium text-red-600">-{formatDH(result.cnssMensuel)}</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 text-gray-600">IR mensuel ({(result.tauxEffectifIR * 100).toFixed(1)}%)</td><td class="px-4 py-2 text-right tabular-nums text-red-600">-{formatDH(result.irMensuel)}</td></tr>
            <tr class="bg-emerald-50"><td class="px-4 py-2 font-bold text-charcoal">Salaire net mensuel</td><td class="px-4 py-2 text-right tabular-nums font-bold text-emerald-700">{formatDH(result.netMensuel)}</td></tr>
            <tr class="bg-emerald-50"><td class="px-4 py-2 font-bold text-charcoal">Salaire net annuel</td><td class="px-4 py-2 text-right tabular-nums font-bold text-emerald-700">{formatDH(result.netAnnuel)}</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Family situation table -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">
        Net selon la situation familiale
      </h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50">
              <th class="px-4 py-2 text-left font-medium text-gray-500">Situation</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">Net/mois</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">Net/an</th>
              <th class="px-4 py-2 text-right font-medium text-gray-500">IR/an</th>
            </tr>
          </thead>
          <tbody>
            {familyScenarios.map(({ label, result: r }) => (
              <tr class="border-t border-gray-100">
                <td class="px-4 py-2 text-gray-700">{label}</td>
                <td class="px-4 py-2 text-right tabular-nums font-medium text-charcoal">{formatDH(r.netMensuel)}</td>
                <td class="px-4 py-2 text-right tabular-nums text-gray-600">{formatDH(r.netAnnuel)}</td>
                <td class="px-4 py-2 text-right tabular-nums text-red-600">{formatDH(r.irAnnuel)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Band context & SMIG comparison -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">
        Positionnement de {amountFormatted} DH brut dans l&rsquo;&eacute;chelle salariale marocaine
      </h2>
      <div class="prose prose-gray max-w-none">
        <p>{bandContext}</p>
        <p>{smigComparison}</p>
      </div>
    </section>

    <!-- Career description -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">
        M&eacute;tiers et profils associ&eacute;s &agrave; {amountFormatted} DH brut
      </h2>
      <div class="prose prose-gray max-w-none">
        <p>{careerDescription}</p>
      </div>
    </section>

    <!-- Annual breakdown -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">
        Vue annuelle : {amountFormatted} DH brut sur 12 mois
      </h2>
      <div class="prose prose-gray max-w-none">
        <p>{annualBreakdown}</p>
      </div>
    </section>

    <!-- Tax optimization -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">
        Optimisation fiscale pour {amountFormatted} DH brut
      </h2>
      <div class="prose prose-gray max-w-none">
        <p>{taxTips}</p>
      </div>
    </section>

    <!-- Raise simulation -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">
        Simulation d&rsquo;augmentation &agrave; partir de {amountFormatted} DH brut
      </h2>
      <div class="prose prose-gray max-w-none">
        <p>{raiseSimulation}</p>
      </div>
    </section>

    <!-- Budget breakdown -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">
        Budget mensuel avec {formatDH(result.netMensuel)} net
      </h2>
      <div class="prose prose-gray max-w-none">
        <p>{budgetBreakdown}</p>
      </div>
    </section>

    <!-- Comparisons to adjacent salaries -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">
        Comparaison avec les salaires proches de {amountFormatted} DH
      </h2>
      <div class="prose prose-gray max-w-none">
        <p>{uniqueComparisons}</p>
      </div>
    </section>

    <!-- Regional context -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">
        Co&ucirc;t de la vie : {formatDH(result.netMensuel)} net selon les villes
      </h2>
      <div class="prose prose-gray max-w-none">
        <p>{regionalContext}</p>
      </div>
    </section>

    <!-- FAQs -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-charcoal">Questions fr&eacute;quentes sur {amountFormatted} DH brut</h2>
      <div class="space-y-3">
        {faqs.map(faq => (
          <details class="group rounded-lg border border-gray-200">
            <summary class="cursor-pointer px-4 py-3 font-medium text-charcoal">{faq.question}</summary>
            <div class="border-t border-gray-200 px-4 py-3 text-sm text-dark-gray">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <div class="mb-8 rounded-xl bg-brand/5 p-6 text-center">
      <p class="text-lg font-medium text-charcoal">Vous souhaitez un calcul plus pr&eacute;cis ?</p>
      <p class="mt-1 text-sm text-gray-600">Ajustez le nombre de personnes &agrave; charge dans le calculateur ci-dessus</p>
      <a href={`/#brut=${page.amount}`} class="mt-4 inline-block rounded-lg bg-brand px-6 py-3 font-medium text-white hover:bg-brand-dark">
        Simulation d&eacute;taill&eacute;e
      </a>
    </div>

    <!-- Adjacent pages -->
    <section class="mb-8">
      <h2 class="mb-4 text-xl font-bold text-charcoal">Salaires proches</h2>
      <div class="flex flex-wrap gap-2">
        {adjacent.map(p => (
          <a href={`/salaire/${p.slug}/`} class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-dark-gray transition-colors hover:border-brand hover:text-brand">
            {formatAmountTitle(p.amount)} DH
          </a>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="mb-8">
      <h2 class="mb-4 text-xl font-bold text-charcoal">Liens utiles</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <a href="/calculateurs/" class="group rounded-lg border border-gray-200 p-3 transition-all hover:border-brand hover:shadow-sm">
          <h3 class="font-semibold text-charcoal group-hover:text-brand text-sm">Tous les calculateurs</h3>
          <p class="text-xs text-gray-500">Brut/net, IR, co&ucirc;t employeur</p>
        </a>
        <a href="/guides/bareme-ir-maroc/" class="group rounded-lg border border-gray-200 p-3 transition-all hover:border-brand hover:shadow-sm">
          <h3 class="font-semibold text-charcoal group-hover:text-brand text-sm">Bar&egrave;me IR Maroc</h3>
          <p class="text-xs text-gray-500">Tranches et taux d&rsquo;imposition</p>
        </a>
        <a href="/salaire/metier/ingenieur/" class="group rounded-lg border border-gray-200 p-3 transition-all hover:border-brand hover:shadow-sm">
          <h3 class="font-semibold text-charcoal group-hover:text-brand text-sm">Salaire ing&eacute;nieur au Maroc</h3>
          <p class="text-xs text-gray-500">Grille et &eacute;volution de carri&egrave;re</p>
        </a>
        <a href="/salaire/ville/casablanca/" class="group rounded-lg border border-gray-200 p-3 transition-all hover:border-brand hover:shadow-sm">
          <h3 class="font-semibold text-charcoal group-hover:text-brand text-sm">Salaire moyen &agrave; Casablanca</h3>
          <p class="text-xs text-gray-500">Grille par secteur et co&ucirc;t de la vie</p>
        </a>
      </div>
    </section>

    <!-- Author + sources -->
    <div class="flex items-center gap-4 rounded-lg border border-gray-200 px-5 py-4">
      <div class="text-sm">
        <p class="font-semibold text-charcoal">
          R&eacute;dig&eacute; par <a href="/a-propos/" class="text-brand hover:underline">Radif Partners</a>
        </p>
        <p class="text-medium-gray">Éditeur de calculateurs et de guides pratiques &middot; Expert en finances personnelles</p>
      </div>
    </div>

    <div class="mt-4 text-xs text-medium-gray">
      <p>Mis &agrave; jour pour l&rsquo;ann&eacute;e fiscale {CURRENT_FISCAL_YEAR}.</p>
      <p class="mt-1">Sources : <a href="https://www.tax.gov.ma" class="underline hover:text-brand" target="_blank" rel="noopener">DGI</a>, <a href="https://www.cnss.ma" class="underline hover:text-brand" target="_blank" rel="noopener">CNSS</a>.</p>
    </div>
  </div>
</Layout>
